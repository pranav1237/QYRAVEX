# SEC requires a descriptive identity and contact address.
SEC_USER_AGENT=ZethetaWorkBridge/0.1 research contact@example.com
SEC_BASE_URL=https://data.sec.gov
# Optional enrichment providers. Keep real keys in local .env or hosting secrets; never commit them.
# NewsAPI: https://newsapi.org/register
# Finnhub: https://finnhub.io/register
FINNHUB_API_KEY=
FRED_API_KEY=
NEWSAPI_API_KEY=
ALPHAVANTAGE_API_KEY=
# Runtime
WORKBRIDGE_DB=./data/workbridge.sqlite
WORKBRIDGE_MAX_STEPS=12
WORKBRIDGE_TIMEOUT_SECONDS=20
WORKBRIDGE_LOG_LEVEL=INFO
